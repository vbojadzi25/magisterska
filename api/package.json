{
  "name": "denar-api",
  "version": "1.0.0",
  "description": "Denar money transfer API backend",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "test": "NODE_ENV=test jest --runInBand",
    "test:watch": "jest --watch",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "migrate": "npx sequelize-cli db:migrate --config src/config/config.js",
    "migrate:undo": "npx sequelize-cli db:migrate:undo --config src/config/config.js",
    "seed": "npx sequelize-cli db:seed:all --config src/config/config.js"
  },
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "morgan": "^1.10.0",
    "compression": "^1.7.4",
    "dotenv": "^16.3.1",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "joi": "^17.11.0",
    "sequelize": "^6.35.1",
    "pg": "^8.11.3",
    "pg-hstore": "^2.3.4",
    "axios": "^1.6.2",
    "uuid": "^9.0.1",
    "express-rate-limit": "^7.1.5",
    "winston": "^3.11.0",
    "express-validator": "^7.0.1",
    "multer": "^1.4.5-lts.1",
    "express-session": "^1.17.3"
  },
  "devDependencies": {
    "nodemon": "^3.0.2",
    "jest": "^29.7.0",
    "supertest": "^6.3.3",
    "eslint": "^8.56.0",
    "eslint-config-standard": "^17.1.0",
    "sequelize-cli": "^6.6.2"
  },
  "keywords": ["fintech", "money-transfer", "p2p", "macedonia", "banking"],
  "author": "Denar Development Team",
  "license": "UNLICENSED"
}