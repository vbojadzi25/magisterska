# Environment Configuration
NODE_ENV=development
PORT=3000

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=pari_dev
DB_USER=pari_user
DB_PASSWORD=pari_password_2024
DB_DIALECT=postgres

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-here-change-this
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your-refresh-secret-here-change-this
JWT_REFRESH_EXPIRES_IN=30d

# Encryption
ENCRYPTION_KEY=32-character-encryption-key-here
SALT_ROUNDS=12

# API Security
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:19006
API_RATE_LIMIT=100

# Banking API Configuration
# Macedonia Banking APIs
SPARKASSE_API_URL=https://api.sparkasse.mk
SPARKASSE_CLIENT_ID=your_sparkasse_client_id
SPARKASSE_CLIENT_SECRET=your_sparkasse_client_secret
SPARKASSE_CERT_PATH=./certs/sparkasse.pem

KOMERCIJALNA_API_URL=https://api.kb.com.mk
KOMERCIJALNA_CLIENT_ID=your_komercijalna_client_id
KOMERCIJALNA_CLIENT_SECRET=your_komercijalna_client_secret

STOPANSKA_API_URL=https://api.stb.com.mk
STOPANSKA_CLIENT_ID=your_stopanska_client_id
STOPANSKA_CLIENT_SECRET=your_stopanska_client_secret

# Open Banking Configuration (if using EU PSD2)
OPEN_BANKING_ENVIRONMENT=sandbox
AISP_CERTIFICATE_PATH=./certs/aisp_cert.pem
PISP_CERTIFICATE_PATH=./certs/pisp_cert.pem
QWAC_CERTIFICATE_PATH=./certs/qwac_cert.pem

# Third-party Services
NOTIFICATION_SERVICE_URL=https://api.notifications.com
EMAIL_SERVICE_API_KEY=your_email_api_key
SMS_SERVICE_API_KEY=your_sms_api_key

# Monitoring & Logging
LOG_LEVEL=info
SENTRY_DSN=your_sentry_dsn_here

# File Upload
MAX_FILE_SIZE=5MB
UPLOAD_PATH=./uploads

# Redis (for session management and caching)
REDIS_URL=redis://localhost:6379
REDIS_TTL=3600

# Development Tools
DEBUG_ENABLED=true
MOCK_BANKING_API=true